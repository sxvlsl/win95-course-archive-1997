 {
  MENUITEM "&Sound",    IDM_SOUND
//  MENUITEM "Save &Opt", IDM_SAVEOPT
 }

 POPUP "&Moves"
 {
  MENUITEM "&Undo",   IDM_UNDO
  MENUITEM "&Replay", IDM_REDO
  MENUITEM "&Show",   IDM_SHOW
 }

 POPUP "&Help"
 {
  MENUITEM "&About...", CM_HELPABOUT
 }
}
